# Copy this file to .env and fill in values. The app runs fine with all of these
# left at their defaults — no external services are required to boot.

# --- Database ---------------------------------------------------------------
# Default: a local SQLite file (zero setup). To use Postgres instead, point this
# at your instance, e.g.
#   DATABASE_URL=postgresql+psycopg://oaksy:oaksy@localhost:5432/oaksy
# (a docker-compose.yml at the repo root will spin one up for you).
DATABASE_URL=sqlite:///./oaksy.db

# --- Auth -------------------------------------------------------------------
# CHANGE THIS in any non-local environment. Used to sign JWTs.
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Claude (AI verdict layer) ----------------------------------------------
# Leave blank to run without AI — the app falls back to the stored analytics
# verdict. Add a key to get real Claude-generated verdicts.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
